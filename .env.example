# ── Local auth (pick ONE auth mode) ──────────────────────────────
# Open-access mode: no login page at all, every visitor is admin.
# Set to "true" to disable auth entirely (what the owner runs):
AUTH_DISABLED=true
# Env-based admin login (simple, only used when AUTH_DISABLED is not true):
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Secret used to sign session cookies (generate: openssl rand -hex 32)
SESSION_SECRET=replace-with-64-hex-chars

# ── Twilio Voice ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-twilio-api-key-secret
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Verified caller ID / Twilio number calls originate from, E.164:
TWILIO_CALLER_ID=+61xxxxxxxxx
# Optional: separate caller ID for the verification "second call" (Leg B) —
# back-to-back calls from one number trip carrier spam screening:
TWILIO_CALLER_ID_LEG_B=

# ── CallVerify merge detection (sub-0.5s path) ───────────────────
# WebSocket relay that runs the Goertzel merge-tone detector.
# Deploy Freshiivy1/merge-relay, then point this at it (bare base URL,
# no query string — the app appends ?sid=<sessionId> itself):
VERIFY_STREAM_URL=wss://your-merge-relay-host
VERIFY_STREAM_SECRET=shared-secret-matching-relay-STREAM_SECRET

# Public origin of the deployed app (no trailing slash). Used for absolute
# Twilio statusCallback URLs on REST-originated calls.
PUBLIC_BASE_URL=https://your-cloudtalk.onrender.com

# ── Database (optional for calling, required for persistent history) ────
# MySQL connection string. Migrations auto-apply on boot when present; when
# absent the app still places calls and returns empty contacts/history.
DATABASE_URL=mysql://user:password@host:3306/cloudtalk

# ── Kimi OAuth (alternative to ADMIN_USERNAME/ADMIN_PASSWORD) ────
# KIMI_CLIENT_ID=
# KIMI_CLIENT_SECRET=
# KIMI_REDIRECT_URI=
